[publicinboxmda]
    spamcheck = none

[publicinbox]
    wwwlisting = all

[publicinbox "caml-list"]
    inboxdir = /root/caml-list.git
    address = caml-list@inria.fr
    url = https://inbox.ci.dev/caml-list
    listid = caml-list.inria.fr
    filter = PublicInbox::Filter::Mirror
    watch = imaps://USER@IMAP-HOST/INBOX
